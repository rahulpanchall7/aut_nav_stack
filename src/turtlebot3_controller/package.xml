<?xml version="1.0"?>
<package format="3">
  <name>turtlebot3_controller</name>
  <version>0.0.0</version>
  <description>Pure Pursuit trajectory tracking controller for TurtleBot3</description>
  <maintainer email="rahulpanchal7.de@gmail.com">rahulpanchal7</maintainer>
  <license>Apache License 2.0</license>

  <!-- Runtime dependencies -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>turtlebot3_msgs</depend> <!-- for your custom Trajectory message -->

  <!-- Test dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
